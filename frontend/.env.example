# Base URL of the Foodiana backend API.
#   Local:      http://localhost:4000
#   Production: https://api.your-domain.com
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD
# time, not read at runtime. On Hostinger this must be set in the frontend app's
# environment before the build runs; changing it afterwards needs a rebuild, not
# a restart. If the deployed site calls localhost:4000, this was unset at build.
#
# There are deliberately no Supabase credentials here. The service-role key lives
# only in the backend environment, and scripts/check-frontend-bundle.mjs fails CI
# if a database client ever reappears in the frontend.
NEXT_PUBLIC_API_URL=http://localhost:4000
